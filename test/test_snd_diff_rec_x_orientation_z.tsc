<?xml version="1.0"?>
<session license="CC-0">
  <scene>
    <source name="p">
      <orientation>0 0 0 0
      1 -360 0 0</orientation>
    </source>
    <receiver parent="p" name="x" type="vmic" a="0.5"/>
    <receiver parent="p" name="xy" type="vmic" a="0.5">
      <orientation>0 45 0 0</orientation>
    </receiver>
    <receiver parent="p" name="y" type="vmic" a="0.5">
      <orientation>0 90 0 0</orientation>
    </receiver>
    <receiver parent="p" name="z" type="vmic" a="0.5">
      <orientation>0 0 -90 0</orientation>
    </receiver>
    <diffuse>
      <plugins>
	<!-- ACN, FuMa: t y z x -->
	<const a="0.7071 0 0 1"/>
      </plugins>
    </diffuse>
  </scene>
</session>
